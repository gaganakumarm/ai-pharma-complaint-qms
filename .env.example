# Copy this file to .env for local development. Never commit real secrets.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pharma_qms
GROQ_API_KEY=
# Groq production model; override when a future AI integration is approved.
GROQ_MODEL=openai/gpt-oss-120b
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=50
MAX_PDF_TEXT_LENGTH=20000
MAX_TEXT_INPUT_LENGTH=20000
VITE_API_URL=http://localhost:8000
